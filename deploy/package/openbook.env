# OpenBook service configuration. Apply changes with: systemctl restart openbook
# This file is kept on upgrades.

# PostgreSQL connection (the database and role must exist; the schema is migrated on start).
DATABASE_URL=postgresql://openbook:CHANGE-ME@localhost:5432/openbook

# Signs login tokens. A random value is generated on first install.
JWT_SECRET=@GENERATED@

# Port for both the web app (/) and the API (/v1).
PORT=3000

# Extra origins allowed to call the API from a browser (comma-separated). The bundled web app uses
# the same origin and needs none.
CORS_ORIGINS=

# Set before running openbook-seed to also create the CMS accounts editor@ and publisher@openbook.local.
#SEED_ADMIN_PASSWORD=
