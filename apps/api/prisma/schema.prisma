generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  parent
  editor
  publisher
}

enum PublishStatus {
  draft
  review
  published
  archived
}

model User {
  id              String         @id @db.Uuid
  email           String         @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  role            Role           @default(parent)
  bannedAt        DateTime?
  createdAt       DateTime       @default(now())
  refreshTokens   RefreshToken[]
  emailTokens     EmailToken[]
}

/// Rotating refresh tokens. A family shares one `familyId`; presenting a rotated (used) token revokes
/// the whole family (reuse detection, NFR-6).
model RefreshToken {
  id         String    @id @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  rotatedAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([familyId])
}

model EmailToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "verify" | "reset"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model Category {
  id            String @id @db.Uuid
  slug          String @unique
  name          Json
  subcategories Json
  sortOrder     Int    @default(0)
  packs         Pack[]
  books         Book[]
}

model Card {
  id          String     @id @db.Uuid
  /// Stable content key, e.g. "birds-1/bald-eagle" (used by the seed to upsert).
  key         String?    @unique
  name        Json
  facts       Json
  width       Int
  height      Int
  renditions  Json
  attribution Json?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
  deletedAt   DateTime?
  packs       PackCard[]
}

model Pack {
  id          String        @id @db.Uuid
  key         String?       @unique
  categoryId  String        @db.Uuid
  category    Category      @relation(fields: [categoryId], references: [id])
  subcategory String
  title       Json
  description Json
  coverCardId String?       @db.Uuid
  version     Int           @default(0)
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
  cards       PackCard[]
}

model PackCard {
  packId   String @db.Uuid
  cardId   String @db.Uuid
  position Int
  pack     Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  card     Card   @relation(fields: [cardId], references: [id])

  @@id([packId, cardId])
  @@index([packId, position])
}

/// Official books (FR-59). Pages are stored as JSON (BookPage[]).
model Book {
  id          String        @id @db.Uuid
  key         String?       @unique
  categoryId  String?       @db.Uuid
  category    Category?     @relation(fields: [categoryId], references: [id])
  title       Json
  stage       Int
  layout      String        @default("text-then-picture")
  showEndPage Boolean       @default(true)
  coverImage  Json?
  pages       Json
  vocabulary  String[]
  version     Int           @default(0)
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
}

model AuditLog {
  id        String   @id @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())
}
